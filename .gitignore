__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.venv/
venv/
*.log

# Ignore data and output files, but keep .gitkeep files for directory structure
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

outputs/models/*
!outputs/models/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/plots/*
!outputs/plots/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
